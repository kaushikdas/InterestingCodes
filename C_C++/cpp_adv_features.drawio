        <mxCell id="qRBLt46ThRu0Fjg32bZc-95" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Lucida Console&amp;quot;;&quot;&gt;shared_ptr&lt;/span&gt;&lt;span class=&quot;T286Pc&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;ep&quot; data-sfc-cb=&quot;&quot; data-processed=&quot;true&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;T286Pc&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;ep&quot; data-sfc-cb=&quot;&quot; data-processed=&quot;true&quot; data-copy-service-computed-style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;b&gt;constructor&lt;/b&gt; makes &lt;font face=&quot;Lucida Console&quot;&gt;sp1&lt;/font&gt; to point to the Widget object, sets the RC and&lt;font face=&quot;Helvetica&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-variant-ligatures: no-common-ligatures;&quot;&gt;detecting the presence of an unambiguous and accessible (i.e. public) &lt;font face=&quot;Lucida Console&quot;&gt;enable_shared_from_this&lt;/font&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-variant-ligatures: no-common-ligatures;&quot;&gt;base and assign the newly created &lt;/span&gt;&lt;span class=&quot;t-lc&quot; style=&quot;background-color: rgb(255, 255, 255); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-variant-ligatures: no-common-ligatures;&quot;&gt;&lt;font face=&quot;Lucida Console&quot;&gt;std::shared_ptr&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-variant-ligatures: no-common-ligatures;&quot;&gt; to &lt;/span&gt;&lt;font face=&quot;Lucida Console&quot;&gt;&lt;code style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 0px; padding: 0px; font-variant-ligatures: no-common-ligatures; white-space: pre;&quot;&gt;&lt;i style=&quot;&quot;&gt;self&lt;/i&gt;&lt;/code&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-variant-ligatures: no-common-ligatures;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;color: rgb(128, 128, 128); background-color: rgb(255, 255, 255); font-variant-ligatures: no-common-ligatures;&quot;&gt;(if not already owned by a live &lt;/span&gt;&lt;span class=&quot;t-lc&quot; style=&quot;color: rgb(128, 128, 128); background-color: rgb(255, 255, 255); font-variant-ligatures: no-common-ligatures;&quot;&gt;&lt;font face=&quot;Lucida Console&quot;&gt;std::shared_ptr&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(128, 128, 128); background-color: rgb(255, 255, 255); font-variant-ligatures: no-common-ligatures;&quot;&gt;. Constructing a &lt;/span&gt;&lt;span class=&quot;t-lc&quot; style=&quot;color: rgb(128, 128, 128); background-color: rgb(255, 255, 255); font-variant-ligatures: no-common-ligatures;&quot;&gt;&lt;font face=&quot;Lucida Console&quot;&gt;std::shared_ptr&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(128, 128, 128); background-color: rgb(255, 255, 255); font-variant-ligatures: no-common-ligatures;&quot;&gt; for an object that is already managed by another &lt;/span&gt;&lt;span class=&quot;t-lc&quot; style=&quot;color: rgb(128, 128, 128); background-color: rgb(255, 255, 255); font-variant-ligatures: no-common-ligatures;&quot;&gt;&lt;font face=&quot;Lucida Console&quot;&gt;std::shared_ptr&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(128, 128, 128); background-color: rgb(255, 255, 255); font-variant-ligatures: no-common-ligatures;&quot;&gt; will not update or share ownership with&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-variant-ligatures: no-common-ligatures;&quot;&gt;&lt;span&gt;&lt;font style=&quot;color: rgb(128, 128, 128);&quot;&gt;&lt;code style=&quot;border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 0px; padding: 0px; white-space: pre;&quot;&gt;&lt;i style=&quot;&quot;&gt;self&lt;/i&gt;&lt;/code&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(128, 128, 128); background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;and so will lead to undefined behavior.)&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="295.25" x="363.5" y="4923" as="geometry" />
